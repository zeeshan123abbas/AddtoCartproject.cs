@model List<Product>
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>


<a asp-action="Create" class="btn btn-primary mb-2">Add New Product</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Price</th>
            <th>Add to Cart</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProductName</td>
                <td>@p.Price</td>
                <td>
                    <a asp-action="AddToCart" asp-route-id="@p.ProductId" class="btn btn-success">
                        Add to Cart
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>